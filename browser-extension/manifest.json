{
  "manifest_version": 3,
  "name": "ResuMatch \u672c\u5730\u6c42\u804c\u52a9\u624b",
  "version": "1.0.7",
  "description": "\u628a Boss \u5c97\u4f4d\u548c\u56de\u590d\u540c\u6b65\u5230\u672c\u5730\u5de5\u4f5c\u53f0\u3002",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "ResuMatch \u672c\u5730\u6c42\u804c\u52a9\u624b",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://www.zhipin.com/*",
    "http://127.0.0.1:8788/*",
    "https://us.i.posthog.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.zhipin.com/*",
        "http://127.0.0.1:8788/*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
